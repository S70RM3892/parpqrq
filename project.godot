; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Parkour"
run/main_scene="res://scenes/ui/title.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
Haptics="*res://scripts/autoload/haptics.gd"
Audio="*res://scripts/autoload/audio.gd"
Game="*res://scripts/autoload/game.gd"
DebugOverlay="*res://scenes/ui/debug_overlay.tscn"
TuningPanel="*res://scenes/ui/tuning_panel.tscn"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

