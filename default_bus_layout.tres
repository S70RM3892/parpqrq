[gd_resource type="AudioBusLayout" load_steps=4 format=3]

[sub_resource type="AudioEffectHardLimiter" id="AudioEffectHardLimiter_master"]
resource_name = "Limiter"
pre_gain_db = 0.0
ceiling_db = -1.0
release = 0.1

[sub_resource type="AudioEffectDelay" id="AudioEffectDelay_room"]
resource_name = "Slapback"
dry = 1.0
tap1_active = false
tap1_delay_ms = 110.0
tap1_level_db = -9.0
tap1_pan = -0.25
tap2_active = false
tap2_delay_ms = 190.0
tap2_level_db = -17.0
tap2_pan = 0.25
feedback_active = false

[sub_resource type="AudioEffectReverb" id="AudioEffectReverb_room"]
resource_name = "Room"
predelay_msec = 10.0
predelay_feedback = 0.0
room_size = 0.2
damping = 0.5
spread = 1.0
hipass = 0.1
dry = 1.0
wet = 0.08

[resource]
bus/0/effect/0/effect = SubResource("AudioEffectHardLimiter_master")
bus/0/effect/0/enabled = true
bus/1/name = &"Music"
bus/1/solo = false
bus/1/mute = false
bus/1/bypass_fx = false
bus/1/volume_db = 0.0
bus/1/send = &"Master"
bus/2/name = &"SFX"
bus/2/solo = false
bus/2/mute = false
bus/2/bypass_fx = false
bus/2/volume_db = 0.0
bus/2/send = &"Master"
bus/3/name = &"SFXRoom"
bus/3/solo = false
bus/3/mute = false
bus/3/bypass_fx = false
bus/3/volume_db = 0.0
bus/3/send = &"SFX"
bus/3/effect/0/effect = SubResource("AudioEffectDelay_room")
bus/3/effect/0/enabled = true
bus/3/effect/1/effect = SubResource("AudioEffectReverb_room")
bus/3/effect/1/enabled = true
